# Copy to `.env` and adjust. Every variable is optional: nuxt.config.ts holds
# a working default for each, so the app runs with no .env at all.

# Public CoinGecko API. Point this at a proxy or a paid plan's host if needed.
NUXT_PUBLIC_COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# News provider, read server-side only.
NUXT_NEWS_API_BASE=https://cryptocurrency.cv/api/v1

# How long to wait on the news provider, in milliseconds.
NUXT_NEWS_REQUEST_TIMEOUT_MS=10000
